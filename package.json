{
  "name": "taller-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRM + gestión de producción para talleres de impresión y decoración (mezcla HighLevel + DecoNetwork)",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node server/seed.js --reset",
    "test": "node --test tests/*.test.js",
    "sanmar:probar": "node --env-file-if-exists=.env scripts/sanmar-probar.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^5.4.21"
  }
}
