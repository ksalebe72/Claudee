# ColorPlus OS en Replit.
# «Run» (botón verde) levanta el MODO DE PRUEBA: datos de ejemplo y simuladores de SanMar y de la IA.
# Requiere Node.js 22.13 o más nuevo (la app usa la base SQLite integrada en Node).
modules = ["nodejs-22"]
run = "npm install && npm run demo"

[[ports]]
localPort = 3001
externalPort = 80

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]
